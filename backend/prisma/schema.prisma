generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MENTOR
}

enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(STUDENT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]

  @@index([role])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  repoUrl     String
  liveUrl     String?
  description String
  status      ProjectStatus @default(PENDING)
  studentId   String
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([studentId, name])
  @@unique([studentId, repoUrl])
  @@index([status])
  @@index([studentId])
}